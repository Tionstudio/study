# LLM API configuration.
# Copy this file to "config.properties" and fill in your real API keys.
# config.properties is listed in .gitignore and must NOT be committed.

# ======================= Model groups =======================
# llm.models — comma-separated list of model group ids.
# Each group has three settings:
#   llm.models.<id>.model         — model name as the API expects it
#   llm.models.<id>.api.key       — API key (use any placeholder for local servers)
#   llm.models.<id>.api.base-url  — OpenAI-compatible base URL
llm.models=cloud,local,gemini

llm.models.cloud.model=openai/gpt-4o-mini
llm.models.cloud.api.key=sk-your-api-key-here
llm.models.cloud.api.base-url=https://openrouter.ai/api/v1
# Approximate price in USD per 1M tokens (prompt/completion) — update to your tariff
llm.models.cloud.price.prompt=0.15
llm.models.cloud.price.completion=0.60

llm.models.local.model=local-model
llm.models.local.api.key=not-required
llm.models.local.api.base-url=http://localhost:1234/v1

# Google Gemini (OpenAI-compatible endpoint of the Gemini API)
llm.models.gemini.model=gemini-3.8-flash
llm.models.gemini.api.key=your-gemini-api-key-here
llm.models.gemini.api.base-url=https://generativelanguage.googleapis.com/v1beta/openai

# Group id (or model name) used for requests when no model is selected
llm.default-model=local

# Group id (or model name) used for batch-result analysis
# ("Анализ результирующей таблицы"). If empty, the default model is used.
llm.analysis.model=cloud

# Local web server port
server.port=8080
